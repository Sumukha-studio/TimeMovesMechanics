# ==========================================
# Unity Gitignore
# ==========================================

# Unity cache and generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]rchives/

# Unity Asset meta data should only be tracked if the asset exists
!/[Aa]ssets/**/*.meta

# Unity crash reports & temporary files
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build outputs & packages
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Packed Addressables & StreamingAssets cache
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE and Project Files
# Visual Studio / Rider / MonoDevelop generated solution & project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE directories
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/

# VS Code (preserve shared config, ignore user/workspace cache)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Unity Profiler captures
*.profiler

# Unity Plastic SCM / Version Control artifacts
.plastic/
ignore.conf

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini
